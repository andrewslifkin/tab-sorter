{
  "manifest_version": 3,
  "name": "AI Tab Organizer",
  "version": "1.0.0",
  "description": "Organize open tabs into native Chrome tab groups using AI",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Organize tabs with AI"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
